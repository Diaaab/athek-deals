---

---

<header class="bg-white shadow-sm sticky top-0 z-50">
    <div class="container mx-auto px-4 max-w-7xl">
        <div class="flex items-center justify-between h-20">
            <!-- Logo -->
            <a href={import.meta.env.BASE_URL} class="flex-shrink-0">
                <img
                    src={`${import.meta.env.BASE_URL}/athek-logo.png`}
                    alt="Athek Logo"
                    class="h-12"
                />
            </a>

            <!-- Navigation (Desktop) -->
            <nav class="hidden md:flex items-center gap-8">
                <a
                    href={import.meta.env.BASE_URL}
                    class="text-gray-700 hover:text-athek-primary font-medium transition-colors"
                    >الرئيسية</a
                >
                <a
                    href="/#deals"
                    class="text-gray-700 hover:text-athek-primary font-medium transition-colors"
                    >العروض</a
                >
                <a
                    href="https://athek.sa"
                    class="text-gray-700 hover:text-athek-primary font-medium transition-colors"
                    >الموقع الرسمي</a
                >
                <a
                    href="#footer"
                    class="text-gray-700 hover:text-athek-primary font-medium transition-colors"
                    >اتصل بنا</a
                >
            </nav>

            <!-- CTA Button -->
            <div class="hidden md:block">
                <a
                    href="https://athek.sa"
                    target="_blank"
                    class="bg-athek-primary text-white px-6 py-2 rounded-lg font-bold hover:bg-opacity-90 transition-colors shadow-lg shadow-athek-primary/20"
                >
                    حمل التطبيق
                </a>
            </div>

            <!-- Mobile Menu Button (Placeholder for now) -->
            <button class="md:hidden text-gray-700 p-2">
                <svg
                    class="w-6 h-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 6h16M4 12h16M4 18h16"></path></svg
                >
            </button>
        </div>
    </div>
</header>
