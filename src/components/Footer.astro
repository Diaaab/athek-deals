---

---

<footer class="bg-[#37795d] text-white pt-16 pb-8">
    <div class="container mx-auto px-4 max-w-7xl">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
            <!-- Brand Section -->
            <div class="col-span-1 md:col-span-1">
                <img
                    src={`${import.meta.env.BASE_URL}/athek-logo.png`}
                    alt="Athek Logo"
                    class="h-16 mb-4 bg-white rounded-lg p-2"
                />
                <p class="text-white/80 text-sm leading-relaxed mb-6">
                    تطبيق أثق يقدم لك تجربة رقمية مميزة لإدارة فواتيرك بذكاء،
                    حيث يمكنك متابعة مصروفاتك بكفاءة عالية، وإدارة ميزانيتك
                    وشؤونك المالية، كما يسمح لك بتنظيم النفقات اليومية بما يعزز
                    من وعيك المالي.
                </p>
            </div>

            <!-- Quick Links -->
            <div>
                <div class="font-bold text-lg mb-4 text-athek-secondary">
                    روابط سريعة
                </div>
                <ul class="space-y-2 text-white/80 text-sm">
                    <li>
                        <a
                            href={import.meta.env.BASE_URL}
                            class="hover:text-white transition-colors"
                            >الرئيسية</a
                        >
                    </li>
                    <li>
                        <a
                            href="#deals"
                            class="hover:text-white transition-colors"
                            >تصفح العروض</a
                        >
                    </li>
                    <li>
                        <a
                            href="https://athek.sa"
                            target="_blank"
                            class="hover:text-white transition-colors"
                            >موقعنا الرسمي</a
                        >
                    </li>
                    <li>
                        <a
                            href="https://athek.sa/features"
                            target="_blank"
                            class="hover:text-white transition-colors"
                            >عن الشركة</a
                        >
                    </li>
                </ul>
            </div>

            <!-- App Links -->
            <div>
                <div class="font-bold text-lg mb-4 text-athek-secondary">
                    حمل التطبيق
                </div>
                <div class="space-y-3">
                    <a
                        href="https://apps.apple.com/us/app/athek-%D8%A3%D8%AB%D9%82/id6478430128"
                        target="_blank"
                        class="block w-40 hover:opacity-80 transition-opacity"
                    >
                        <img
                            src={`${import.meta.env.BASE_URL}/images/app_store.svg`}
                            alt="App Store"
                        />
                    </a>
                    <a
                        href="https://play.google.com/store/apps/details?id=com.vroad.athekllc"
                        target="_blank"
                        class="block w-40 hover:opacity-80 transition-opacity"
                    >
                        <img
                            src={`${import.meta.env.BASE_URL}/images/google_play.svg`}
                            alt="Google Play"
                        />
                    </a>
                    <a
                        href="https://appgallery.huawei.com/app/C110399085"
                        target="_blank"
                        class="block w-40 hover:opacity-80 transition-opacity"
                    >
                        <img
                            src={`${import.meta.env.BASE_URL}/images/app_gallery.svg`}
                            alt="Huawei AppGallery"
                        />
                    </a>
                </div>
            </div>

            <!-- Social Media -->
            <div>
                <div class="font-bold text-lg mb-4 text-athek-secondary">
                    تابعنا
                </div>
                <div class="flex flex-wrap gap-3">
                    <!-- Twitter / X -->
                    <a
                        href="https://x.com/athekapp"
                        target="_blank"
                        class="bg-white/10 p-2 rounded-full hover:bg-athek-secondary hover:text-athek-primary transition-colors"
                        aria-label="Twitter"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                            ></path></svg
                        >
                    </a>
                    <!-- Instagram -->
                    <a
                        href="https://www.instagram.com/athekapp/"
                        target="_blank"
                        class="bg-white/10 p-2 rounded-full hover:bg-athek-secondary hover:text-athek-primary transition-colors"
                        aria-label="Instagram"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                            ></path></svg
                        >
                    </a>
                    <!-- Snapchat -->
                    <a
                        href="https://www.snapchat.com/add/athekapp"
                        target="_blank"
                        class="bg-white/10 p-2 rounded-full hover:bg-athek-secondary hover:text-athek-primary transition-colors"
                        aria-label="Snapchat"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                d="M12.003 2c-2.822 0-5.69 1.135-6.793 3.99-1.125 0-2.204.665-2.204 2.112 0 .618.396 1.403.497 1.636 0 0 .542 1.942.506 2.197-.037.255-.705 1.437-.705 1.437s-.404.912-.191 1.258c.214.346 1.353 1.282 1.353 1.282s.373.911.332 1.458c-.041.546-.77 1.114-1.098 1.478-.329.364-.265.99-.265.99s.119.794 1.36.794c1.24 0 1.587-.122 2.636-.584 1.05-.461 2.308.156 2.308.156s.896.794 2.261.794c1.366 0 2.262-.794 2.262-.794s1.259-.617 2.308-.156c1.05.462 1.396.584 2.637.584 1.24 0 1.359-.794 1.359-.794s.064-.626-.265-.99c-.328-.364-1.057-.932-1.098-1.478-.041-.547.332-1.458.332-1.458s1.14-1.026 1.353-1.282c.214-.346-.191-1.258-.191-1.258s-.668-1.182-.705-1.437c-.036-.255.506-2.197.506-2.197.101-.233.497-1.018.497-1.636 0-1.447-1.079-2.112-2.204-2.112-1.104-2.855-3.972-3.99-6.793-3.99z"
                            ></path></svg
                        >
                    </a>
                    <!-- Facebook -->
                    <a
                        href="https://www.facebook.com/athekapp/"
                        target="_blank"
                        class="bg-white/10 p-2 rounded-full hover:bg-athek-secondary hover:text-athek-primary transition-colors"
                        aria-label="Facebook"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.791-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                            ></path></svg
                        >
                    </a>
                    <!-- LinkedIn -->
                    <a
                        href="https://sa.linkedin.com/company/athekapp"
                        target="_blank"
                        class="bg-white/10 p-2 rounded-full hover:bg-athek-secondary hover:text-athek-primary transition-colors"
                        aria-label="LinkedIn"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                            ></path></svg
                        >
                    </a>
                    <!-- TikTok -->
                    <a
                        href="https://www.tiktok.com/@athekapp"
                        target="_blank"
                        class="bg-white/10 p-2 rounded-full hover:bg-athek-secondary hover:text-athek-primary transition-colors"
                        aria-label="TikTok"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"
                            ></path></svg
                        >
                    </a>
                    <!-- YouTube -->
                    <a
                        href="https://www.youtube.com/channel/UC7RWbyYuzYg14az0ykjQjmg"
                        target="_blank"
                        class="bg-white/10 p-2 rounded-full hover:bg-athek-secondary hover:text-athek-primary transition-colors"
                        aria-label="YouTube"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
                            ></path></svg
                        >
                    </a>
                </div>
            </div>
        </div>
        <div
            class="border-t border-white/10 pt-8 text-center text-white/60 text-sm"
        >
            <p>
                &copy; {new Date().getFullYear()} تطبيق اثق. جميع الحقوق محفوظة.
            </p>
        </div>
    </div>
</footer>
