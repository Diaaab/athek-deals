{
  "name": "athek-deals",
  "type": "javascript",
  "main": "dist/server/entry.mjs",
  "site": {
    "bucket": "./dist/client"
  },
  "build": {
    "command": "npm run build",
    "cwd": "./"
  },
  "env": {
    "production": {
      "routes": [
        {
          "pattern": "*.html",
          "zone_name": "example.com"
        },
        {
          "pattern": "*.json",
          "zone_name": "example.com"
        }
      ]
    }
  },
  "limits": {
    "cpu_ms": 50
  }
}
